#: app.py:87 app.py:169
msgid "Conference Name is required"
msgstr "Konferenssin nimi on pakollinen"

#: app.py:93
msgid "User count must be between 1 and 1000"
msgstr "Käyttäjien määrän tulee olla välillä 1-1000"

#: app.py:96
msgid "User count must be a valid number"
msgstr "Käyttäjien määrän tulee olla kelvollinen luku"

#: app.py:133
#, python-format
msgid "Users created successfully! Conference: %(conference)s, Count: %(count)s"
msgstr "Käyttäjät luotu onnistuneesti! Konferenssi: %(conference)s, Määrä: %(count)s"

#: app.py:140
#, python-format
msgid "Error creating users: %(error)s"
msgstr "Virhe käyttäjien luomisessa: %(error)s"

#: app.py:144 app.py:209
msgid "Timeout while executing PowerShell script"
msgstr "Aikakatkaisu PowerShell-skriptin suorittamisessa"

#: app.py:146 app.py:211
msgid "PowerShell (pwsh) is not installed or not available in PATH"
msgstr "PowerShell (pwsh) ei ole asennettu tai ei ole käytettävissä PATH:issa"

#: app.py:148 app.py:213
#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Odottamaton virhe: %(error)s"

#: app.py:199
#, python-format
msgid "Users removed successfully! Conference: %(conference)s"
msgstr "Käyttäjät poistettu onnistuneesti! Konferenssi: %(conference)s"

#: app.py:205
#, python-format
msgid "Error removing users: %(error)s"
msgstr "Virhe käyttäjien poistamisessa: %(error)s"

